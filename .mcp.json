{
  "mcpServers": {
    "grafana-local": {
      "command": "mcp-grafana",
      "args": ["--disable-write"],
      "env": {
        "GRAFANA_URL": "http://localhost:3000",
        "GRAFANA_USERNAME": "admin",
        "GRAFANA_PASSWORD": "admin"
      }
    },
    "grafana-cloud": {
      "command": "mcp-grafana",
      "args": ["--disable-write"],
      "env": {
        "GRAFANA_URL": "${GRAFANA_CLOUD_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_CLOUD_TOKEN}"
      }
    }
  }
}
