#!/usr/bin/env bash
# Run Claude Code inside the isolated dev container while editing on the host (WSL).
# The container mounts only the workspace + forwards 2 tokens, so the agent has no
# path to host secrets (sops, ssh keys, credentials). k3d/Tilt stay native on the host.
set -euo pipefail

# Resolve workspace root (parent of this script's dir).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE="$(cd "${SCRIPT_DIR}/.." && pwd)"

# The devcontainer CLI is a host Node process that pulls features (docker-in-docker) from
# ghcr.io through the corporate proxy. Point its Node TLS at the corporate CA so the fetch
# trusts the proxy's chain. (The baked-in CA only covers the built image, not this host CLI.)
CORP_CA="${WORKSPACE}/ecommerce-infrastructure/environments/local/certs/ca-certificates.crt"
if [ -f "${CORP_CA}" ]; then
  export NODE_EXTRA_CA_CERTS="${CORP_CA}"
fi

# Locate the devcontainer CLI: prefer installed binary, fall back to npx.
if command -v devcontainer >/dev/null 2>&1; then
  DEVCONTAINER=(devcontainer)
elif command -v npx >/dev/null 2>&1; then
  DEVCONTAINER=(npx --yes @devcontainers/cli)
else
  echo "error: devcontainer CLI not found. Install it with:" >&2
  echo "  npm install -g @devcontainers/cli" >&2
  exit 1
fi

# Require the forwarded tokens to be present on the host (read by ${localEnv:...} at 'up' time).
: "${ANTHROPIC_AUTH_TOKEN:?ANTHROPIC_AUTH_TOKEN must be exported on the host}"
: "${NODE_AUTH_TOKEN:?NODE_AUTH_TOKEN must be exported on the host}"

# Bring the container up (idempotent — reuses a running one, rebuilds only if config changed).
"${DEVCONTAINER[@]}" up --workspace-folder "${WORKSPACE}"

# Exec Claude inside. With no args -> interactive session; args pass straight through.
exec "${DEVCONTAINER[@]}" exec --workspace-folder "${WORKSPACE}" claude "$@"
